<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_stock_links" model="ir.ui.view">
        <field name="name">account.move.form.stock.links.smart.buttons</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'oe_button_box')]" position="inside">
                <button
                    name="action_view_related_stock_pickings"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="stock_picking_count == 0">
                    <field
                        name="stock_picking_count"
                        widget="statinfo"
                        string="Pickings"/>
                </button>

                <button
                    name="action_view_related_stock_moves"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    invisible="stock_move_count == 0">
                    <field
                        name="stock_move_count"
                        widget="statinfo"
                        string="Stock Moves"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
