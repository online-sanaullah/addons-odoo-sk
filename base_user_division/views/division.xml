<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_company_division_form">
      <field name="name">view.company.division.form</field>
      <field name="model">company.division</field>
      <field name="arch" type="xml">
        <form string="Company Division">
        	<sheet>
        		<div class="oe_title">
				    <label for="name"/>
				    <h1>
				        <field name="name" class="o_text_overflow" placeholder="e.g. TCL" required="True"/>
				    </h1>
				</div>
				<notebook>
					<page string="Users" >
					    <field name="user_ids" nolabel="1"/>
					</page>
				</notebook>
        	</sheet>
        </form>
      </field>
    </record>
    
</odoo>