<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="monthly_trial_balance_analytic_report" model="account.report">
        <field name="name">Monthly Trial Balance by Analytic</field>
        <field name="filter_multi_company">selector</field>
        <field name="filter_date_range" eval="True"/>
        <field name="default_opening_date_filter">this_year</field>
        <field name="filter_show_draft" eval="False"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_analytic" eval="True"/>
        <field name="search_bar" eval="True"/>
        <field name="availability_condition">always</field>
        <field name="custom_handler_model_id" ref="model_monthly_trial_balance_analytic_report_handler"/>
        <field name="column_ids">
            <record id="monthly_trial_balance_analytic_col_year" model="account.report.column">
                <field name="name">Year</field>
                <field name="expression_label">year</field>
                <field name="figure_type">string</field>
                <field name="sequence">1</field>
            </record>
            <record id="monthly_trial_balance_analytic_col_month" model="account.report.column">
                <field name="name">Month</field>
                <field name="expression_label">month</field>
                <field name="figure_type">string</field>
                <field name="sequence">2</field>
            </record>
            <record id="monthly_trial_balance_analytic_col_plan" model="account.report.column">
                <field name="name">Analytic Plan</field>
                <field name="expression_label">analytic_plan</field>
                <field name="figure_type">string</field>
                <field name="sequence">3</field>
            </record>
            <record id="monthly_trial_balance_analytic_col_analytic" model="account.report.column">
                <field name="name">Analytic Account</field>
                <field name="expression_label">analytic_account</field>
                <field name="figure_type">string</field>
                <field name="sequence">4</field>
            </record>
            <record id="monthly_trial_balance_analytic_col_account_code" model="account.report.column">
                <field name="name">Account Code</field>
                <field name="expression_label">account_code</field>
                <field name="figure_type">string</field>
                <field name="sequence">5</field>
            </record>
            <record id="monthly_trial_balance_analytic_col_account" model="account.report.column">
                <field name="name">Account</field>
                <field name="expression_label">account_name</field>
                <field name="figure_type">string</field>
                <field name="sequence">6</field>
            </record>
            <record id="monthly_trial_balance_analytic_col_type" model="account.report.column">
                <field name="name">Account Type</field>
                <field name="expression_label">account_type</field>
                <field name="figure_type">string</field>
                <field name="sequence">7</field>
            </record>
            <record id="monthly_trial_balance_analytic_col_open_bal" model="account.report.column">
                <field name="name">Initial Balance</field>
                <field name="expression_label">initial_balance</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">8</field>
            </record>
            <record id="monthly_trial_balance_analytic_col_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">9</field>
            </record>
            <record id="monthly_trial_balance_analytic_col_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">10</field>
            </record>
            <record id="monthly_trial_balance_analytic_col_end_bal" model="account.report.column">
                <field name="name">Ending Balance</field>
                <field name="expression_label">ending_balance</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">11</field>
            </record>
        </field>
    </record>

    <record id="action_monthly_trial_balance_analytic_report" model="ir.actions.client">
        <field name="name">Monthly Trial Balance by Analytic</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('monthly_trial_balance_analytic_report')}"/>
    </record>

    <menuitem id="menu_monthly_trial_balance_analytic_report"
              name="Monthly Trial Balance by Analytic"
              parent="account_reports.account_reports_audit_reports_menu"
              action="action_monthly_trial_balance_analytic_report"
              sequence="262"
              groups="account.group_account_readonly"/>
</odoo>
