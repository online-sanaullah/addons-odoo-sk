<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_partner_account_approval" model="ir.ui.view">
        <field name="name">account.move.form.partner.account.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="partner_account_approval_warning" invisible="1"/>
                <field name="partner_account_approval_message" invisible="1"/>
                <div class="alert alert-warning mb-2"
                     role="alert"
                     invisible="not partner_account_approval_warning">
                    <field name="partner_account_approval_message"
                           nolabel="1"
                           readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
