<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_partner_account_approval" model="ir.ui.view">
        <field name="name">res.config.settings.form.partner.account.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Partner Account Approval"
                       name="partner_account_approval_settings">

                    <setting id="partner_receivable_account_approval_setting"
                             string="Require Receivable Account Approval"
                             help="Require approval when the receivable account is changed on a partner.">
                        <field name="enforce_partner_receivable_account_approval"/>
                        <div class="content-group mt16"
                             invisible="not enforce_partner_receivable_account_approval">
                            <label for="receivable_account_approval_trigger"/>
                            <field name="receivable_account_approval_trigger"/>
                        </div>
                    </setting>

                    <setting id="partner_payable_account_approval_setting"
                             string="Require Payable Account Approval"
                             help="Require approval when the payable account is changed on a partner.">
                        <field name="enforce_partner_payable_account_approval"/>
                        <div class="content-group mt16"
                             invisible="not enforce_partner_payable_account_approval">
                            <label for="payable_account_approval_trigger"/>
                            <field name="payable_account_approval_trigger"/>
                        </div>
                    </setting>

                    <setting id="partner_account_approval_category_setting"
                             string="Approval Category"
                             help="Approval category used for partner receivable and payable account changes."
                             invisible="not enforce_partner_receivable_account_approval and not enforce_partner_payable_account_approval">
                        <field name="partner_account_approval_category_id"
                               options="{'no_create': False}"/>
                    </setting>

                    <setting id="partner_account_approval_blocking_scope_setting"
                             string="Pending Approval Blocking Scope"
                             help="Choose whether to block only the pending account or all receivable/payable accounts for the partner while approval is pending."
                             invisible="not enforce_partner_receivable_account_approval and not enforce_partner_payable_account_approval">
                        <field name="partner_account_approval_blocking_scope"/>
                    </setting>

                </block>
            </xpath>
        </field>
    </record>
</odoo>
