<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_google_review_qr" model="ir.ui.view">
        <field name="name">pos.config.form.google.review.qr</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting
                    id="google_review_qr_setting"
                    string="Google Review QR"
                    help="Print a QR code that opens this shop's Google Maps review page">
                    <field name="google_review_qr_enabled"/>
                    <div class="content-group mt16" invisible="not google_review_qr_enabled">
                        <div class="row">
                            <label
                                for="google_review_url"
                                string="Google review link"
                                class="col-lg-4 o_light_label"/>
                            <field
                                name="google_review_url"
                                widget="url"
                                required="google_review_qr_enabled"
                                placeholder="https://g.page/r/.../review"/>
                        </div>
                        <div class="row">
                            <label
                                for="google_review_qr_title"
                                string="Heading"
                                class="col-lg-4 o_light_label"/>
                            <field name="google_review_qr_title"/>
                        </div>
                        <div class="row">
                            <label
                                for="google_review_qr_message"
                                string="Message"
                                class="col-lg-4 o_light_label"/>
                            <field name="google_review_qr_message"/>
                        </div>
                        <div class="text-muted">
                            Use the “Ask for reviews” link from Google Business Profile.
                            Reload an open PoS after changing this setting.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
