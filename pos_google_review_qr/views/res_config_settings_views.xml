<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_google_review_qr" model="ir.ui.view">
        <field name="name">res.config.settings.form.google.review.qr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting
                    id="google_review_qr_receipt_setting"
                    string="Google Review QR Code"
                    help="Print a QR code that opens the selected shop's Google Maps review page">
                    <field name="pos_google_review_qr_enabled"/>
                    <div class="content-group mt16" invisible="not pos_google_review_qr_enabled">
                        <div class="row">
                            <label
                                for="pos_google_review_url"
                                string="Google review link"
                                class="col-lg-3 o_light_label"/>
                            <field
                                name="pos_google_review_url"
                                widget="url"
                                required="pos_google_review_qr_enabled"
                                placeholder="https://g.page/r/.../review"/>
                        </div>
                        <div class="row">
                            <label
                                for="pos_google_review_qr_title"
                                string="Heading"
                                class="col-lg-3 o_light_label"/>
                            <field name="pos_google_review_qr_title"/>
                        </div>
                        <div class="row">
                            <label
                                for="pos_google_review_qr_message"
                                string="Message"
                                class="col-lg-3 o_light_label"/>
                            <field name="pos_google_review_qr_message"/>
                        </div>
                        <div class="text-muted">
                            Use the “Ask for reviews” link from Google Business Profile.
                            Reload an open PoS after changing this setting.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
