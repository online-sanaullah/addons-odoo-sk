<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Read remains unrestricted. These rules only protect create/write/delete.
        UI visibility is still handled dynamically through search/window-action domains.
    -->
    <record id="product_pricelist_team_user_access_rule" model="ir.rule">
        <field name="name">Pricelist Team/User Access: Create/Write/Delete</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="domain_force">
            [('id', '!=', 0)] if user.has_group('base.group_system') else [
                '|',
                '&amp;', ('access_team_ids', '=', False), ('access_user_ids', '=', False),
                ('access_granted_user_ids', 'in', [user.id])
            ]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="product_pricelist_item_team_user_access_rule" model="ir.rule">
        <field name="name">Pricelist Item Team/User Access: Create/Write/Delete</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="domain_force">
            [
                '|',
                '&amp;', ('pricelist_id.access_team_ids', '=', False), ('pricelist_id.access_user_ids', '=', False),
                ('pricelist_id.access_granted_user_ids', 'in', [user.id])
            ]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

