        <field name="domain_force">
            [('id', '!=', 0)] if user.has_group('base.group_system') else [
                '|',
                ('pricelist_id', '=', False),
                '|',
                '&amp;', ('pricelist_id.access_team_ids', '=', False), ('pricelist_id.access_user_ids', '=', False),
                ('pricelist_id.access_granted_user_ids', 'in', [user.id])
            ]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>


    <record id="sale_order_line_pricelist_team_user_access_rule" model="ir.rule">
        <field name="name">Sale Order Line Pricelist Team/User Access: Create/Write/Delete</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">
            [('id', '!=', 0)] if user.has_group('base.group_system') else [
                '|',
                ('order_id.pricelist_id', '=', False),
                '|',
                '&amp;', ('order_id.pricelist_id.access_team_ids', '=', False), ('order_id.pricelist_id.access_user_ids', '=', False),
                ('order_id.pricelist_id.access_granted_user_ids', 'in', [user.id])
            ]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
