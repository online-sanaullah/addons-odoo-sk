<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_view_form_inherit_team_user_access" model="ir.ui.view">
        <field name="name">product.pricelist.form.inherit.team.user.access</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_settings']" position="after">
                <group string="Access Restriction" name="team_user_access_restriction">
                    <field name="access_team_ids"
                           widget="many2many_tags"
                           options="{'no_create_edit': True}"/>
                    <field name="access_user_ids"
                           widget="many2many_tags"
                           options="{'no_create_edit': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_view_tree_inherit_team_user_access" model="ir.ui.view">
        <field name="name">product.pricelist.tree.inherit.team.user.access</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_restricted_by_team_user" optional="show"/>
                <field name="access_team_ids" widget="many2many_tags" optional="hide"/>
                <field name="access_user_ids" widget="many2many_tags" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_view_search_inherit_team_user_access" model="ir.ui.view">
        <field name="name">product.pricelist.search.inherit.team.user.access</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="access_team_ids"/>
                <field name="access_user_ids"/>
                <filter name="restricted_by_team_user" string="Restricted" domain="[('is_restricted_by_team_user', '=', True)]"/>
                <filter name="public_team_user_access" string="Public" domain="[('is_restricted_by_team_user', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
