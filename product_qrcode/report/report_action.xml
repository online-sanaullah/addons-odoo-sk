<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
<!--        report action for product-->
        <record id="product_qrcode.print_qr1" model="ir.actions.report">
            <field name="name">QR code</field>
            <field name="model">product.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">product_qrcode.customer_qr_template</field>
            <field name="report_file">product_qrcode.customer_qr_template</field>
            <field name="paperformat_id"  ref="product_qrcode.customer_badge_paperformat"/>
            <field name="print_report_name">'%s - Badge' % object.name</field>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
