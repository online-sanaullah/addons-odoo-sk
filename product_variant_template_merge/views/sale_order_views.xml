<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_direct_product_variant_selection" model="ir.ui.view">
        <field name="name">sale.order.form.direct.product.variant.selection</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_product_configurator.sale_order_view_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <!--
                The configurator module shows product_template_id by default and hides
                product_id.  Searching a template that has several variants therefore
                opens the product configurator.  Make the concrete product.product field
                the default column instead, so an internal reference or barcode selects
                that exact variant directly on the sale order line.
            -->
            <xpath expr="//tree/field[@name='product_template_id']" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="string">Product Template</attribute>
            </xpath>

            <xpath expr="//tree/field[@name='product_id']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="string">Product</attribute>
                <attribute name="placeholder">Search by internal reference, barcode, or product name...</attribute>
            </xpath>
        </field>
    </record>
</odoo>
