<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_variant_combine_wizard_form" model="ir.ui.view">
        <field name="name">product.variant.combine.wizard.form</field>
        <field name="model">product.variant.combine.wizard</field>
        <field name="arch" type="xml">
            <form string="Combine Products into One Template">
                <div class="alert alert-warning" role="alert">
                    This operation keeps the existing product variant records but changes
                    their product template and attribute combination. Take a database backup
                    before using it in production.
                </div>
                <group>
                    <group>
                        <field name="new_template_name"/>
                        <field name="variant_attribute_name"/>
                        <field name="base_product_id" domain="[('id', 'in', product_ids)]"/>
                    </group>
                    <group>
                        <field name="preserve_sale_prices"/>
                        <field name="migrate_vendor_pricelists"/>
                        <field name="archive_empty_templates"/>
                    </group>
                </group>
                <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="source_template_id" readonly="1"/>
                        <field name="internal_reference" readonly="1"/>
                        <field name="current_sale_price" readonly="1"/>
                        <field name="variant_value_name"/>
                    </tree>
                </field>
                <div class="text-muted">
                    Product Category and Vendor Taxes on the new template are copied from the
                    Base Product. Template-level records in other applications or custom modules,
                    such as template-wide BOMs or template-only pricelist rules, remain linked to
                    the archived source templates and may need a project-specific migration.
                </div>
                <footer>
                    <button name="action_combine" string="Combine Products" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_variant_combine_wizard" model="ir.actions.act_window">
        <field name="name">Combine into New Product Template</field>
        <field name="res_model">product.variant.combine.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_product_variant_combine_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
