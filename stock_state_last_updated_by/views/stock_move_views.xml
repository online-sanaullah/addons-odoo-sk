<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_move_tree_show_state_updated_by" model="ir.ui.view">
        <field name="name">stock.move.tree.show.state.updated.by</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="state_last_updated_by_id" string="State Updated By" optional="show" widget="many2one_avatar_user"/>
                <field name="state_last_updated_on" string="State Updated On" optional="hide"/>
                <field name="state_last_updated_source" string="State Updated Source" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
